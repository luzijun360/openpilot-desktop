+      store_c = C[i].store(A[i] * 2.0)
+      store_d = D[i].store(A[i] * 3.0)
+      return UOp.group(store_c, store_d).end(i).sink(arg=KernelInfo(name="my_kernel"))
+
+    def my_grad(d_c:UOp, d_d:UOp, call:UOp):

+def usb_xfer(dev, half:int) -> UOp: # one bulk OUT transfer per half
+  return UOp.placeholder((ctypes.sizeof(libusb.struct_libusb_transfer),), dtypes.uint8, 0, device=to_tuple(dev)[0], tag=f"usb_xfer{half}")

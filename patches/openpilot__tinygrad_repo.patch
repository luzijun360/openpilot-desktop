+# ** MXFP4 GEMM custom kernel
+
+MXFP4_TILES = ((256, 256), (192, 256), (128, 512))
+MXFP4_TILE_MAP = {(6144, 4096, 16384):(192, 256), (16384, 4096, 6144):(128, 512), (16384, 6144, 4096):(128, 512)}

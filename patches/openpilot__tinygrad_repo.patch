-    if len(ends) <= 1: continue
-    by_ctx: dict[frozenset[UOp], list[UOp]] = {}
-    for e in ends: by_ctx.setdefault(frozenset(e.ranges), []).append(e)
-    for i, group in enumerate(by_ctx.values()):

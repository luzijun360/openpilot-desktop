-__device__ static inline T packed_shfl_down(uint64_t mask, const T &f, int delta) {
-
-    if constexpr (std::is_same_v<T, bf16_2> || std::is_same_v<T, bf16>) {
-        static_assert(sizeof(__hip_bfloat162) == sizeof(unsigned int));

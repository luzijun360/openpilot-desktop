-  if (enter_bootloader_mode == ENTER_BOOTLOADER_MAGIC) {
-  #ifdef PANDA
-    current_board->set_esp_gps_mode(ESP_GPS_DISABLED);
-  #endif
-    current_board->set_led(LED_GREEN, 1);

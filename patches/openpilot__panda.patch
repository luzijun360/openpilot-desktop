-  #ifdef ELM_DEBUG
-  os_printf("Starting up timer\n");
-  #endif
-
-  loopcount = LOOPCOUNT_FULL;
-  os_timer_disarm(&elm_timeout);
-  os_timer_setfn(&elm_timeout, (os_timer_func_t *)elm_ISO15765_timer_cb, proto);
-  os_timer_arm(&elm_timeout, elm_mode_timeout, 0);

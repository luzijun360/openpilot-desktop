-    ret = to_signed(ret, 11)
-  elif mode == Panda.SAFETY_HYUNDAI:
-    ret = ((to_send.RDLR >> 16) & 0x7ff) - 1024
-  elif mode == Panda.SAFETY_CHRYSLER:

-  if (valid && (GET_BUS(to_push) == 0)) {
-    int addr = GET_ADDR(to_push);
-
-    // Measured eps torque
-    if (addr == 544) {
-      int torque_meas_new = ((GET_BYTE(to_push, 4) & 0x7U) << 8) + GET_BYTE(to_push, 5) - 1024U;
-
-      // update array of samples
-      update_sample(&torque_meas, torque_meas_new);

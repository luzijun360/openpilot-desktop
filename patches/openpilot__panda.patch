-
-void jump_to_bootloader(void) {
-  // do enter bootloader
-  enter_bootloader_mode = 0;
-  void (*bootloader)(void) = (void (*)(void)) (*((uint32_t *)0x1fff0004));
-
-  // jump to bootloader
-  bootloader();
-
-  // reset on exit
-  enter_bootloader_mode = BOOT_NORMAL;

-  elif mode == Panda.SAFETY_TOYOTA:
-    ret = addr == 0x2E4
-  elif mode == Panda.SAFETY_GM:
-    ret = addr == 384
-  elif mode == Panda.SAFETY_HYUNDAI:
-    ret = addr == 832
-  elif mode == Panda.SAFETY_CHRYSLER:
-    ret = addr == 0x292
-  elif mode == Panda.SAFETY_SUBARU:
-    ret = addr == 0x122

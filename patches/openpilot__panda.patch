-  int bus = GET_BUS(to_send);
-  int length = GET_LEN(to_send);
-
-  bool allowed = false;
-  for (int i = 0; i < len; i++) {
-    if ((addr == msg_list[i].addr) && (bus == msg_list[i].bus) && (length == msg_list[i].len)) {
-      allowed = true;
-      break;
-    }
-  }
-  return allowed;

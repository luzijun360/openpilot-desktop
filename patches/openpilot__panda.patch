-
-  GPIOA->MODER = 0; GPIOB->MODER = 0; GPIOC->MODER = 0;
-  GPIOA->ODR = 0; GPIOB->ODR = 0; GPIOC->ODR = 0;
-  GPIOA->PUPDR = 0; GPIOB->PUPDR = 0; GPIOC->PUPDR = 0;
-
-  detect_configuration();
-  detect_board_type();

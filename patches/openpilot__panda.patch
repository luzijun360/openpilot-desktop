-// convert a trimmed integer to signed 32 bit int
-int to_signed(int d, int bits) {
-  int d_signed = d;
-  if (d >= (1 << MAX((bits - 1), 0))) {
-    d_signed = d - (1 << MAX(bits, 0));
-  }
-  return d_signed;
